# Canonical environment schema. Copy to .env.dev or .env.prod and change only values.
# For values containing $, #, spaces, or other env syntax, use single quotes.
AIRFLOW_ENV_FILE=.env.dev
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_API_PORT=8080
AIRFLOW_LOG_DIR=./logs

AIRFLOW_DATABASE_HOST=postgres.example.internal
AIRFLOW_DATABASE_PORT=5432
AIRFLOW_DATABASE_NAME=airflow_metadata
AIRFLOW_DATABASE_USER=airflow_meta
AIRFLOW_DATABASE_PASSWORD=REPLACE_WITH_METADATA_PASSWORD

AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_EXISTING_OR_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

AIRFLOW_CREATE_ADMIN_USER=true
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# External connections. IDs must use lowercase snake_case.
AIRFLOW_CONNECTION_IDS=mysql,postgres

AIRFLOW_CONNECTION_MYSQL_TYPE=mysql
AIRFLOW_CONNECTION_MYSQL_HOST=mysql.example.internal
AIRFLOW_CONNECTION_MYSQL_PORT=3306
AIRFLOW_CONNECTION_MYSQL_DATABASE=olist
AIRFLOW_CONNECTION_MYSQL_USER=airflow_source
AIRFLOW_CONNECTION_MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD

AIRFLOW_CONNECTION_POSTGRES_TYPE=postgres
AIRFLOW_CONNECTION_POSTGRES_HOST=postgres.example.internal
AIRFLOW_CONNECTION_POSTGRES_PORT=5432
AIRFLOW_CONNECTION_POSTGRES_DATABASE=ecommerce_dw
AIRFLOW_CONNECTION_POSTGRES_USER=airflow_warehouse
AIRFLOW_CONNECTION_POSTGRES_PASSWORD=REPLACE_WITH_WAREHOUSE_PASSWORD
